<Project>

  <PropertyGroup>
    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
    <!-- Every project commits a packages.lock.json so a commit fully determines its package graph;
         the container image and the CWBI workflow restore with -locked-mode against it. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- Opt-in XML documentation enforcement. Normal builds do not fail on missing docs;
       scripts/validate-code-xml-docs.ps1 passes -p:EnforceXmlDocumentation=true to promote
       the CS15xx documentation warnings to errors. -->
  <PropertyGroup Condition="'$(EnforceXmlDocumentation)' == 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1570;CS1571;CS1572;CS1573;CS1574;CS1584;CS1587;CS1589;CS1591</WarningsAsErrors>
  </PropertyGroup>

</Project>

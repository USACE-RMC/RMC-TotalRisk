<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- The harness is a measurement tool outside the solution: it is never part of the fast
         gate or the Release build, and it carries no test framework - Stopwatch only. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- RMC.Numerics flows transitively through the library's PackageReference. -->
    <ProjectReference Include="..\..\..\src\RMC.TotalRisk\RMC.TotalRisk.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="MSTest.Sdk/3.6.4">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyTitle>RMC.TotalRisk.Tests</AssemblyTitle>
    <Description>Fast unit tests for RMC.TotalRisk (the headless compute library).</Description>
    <Company>U.S. Army Corps of Engineers</Company>
    <Product>RMC-TotalRisk</Product>
    <Copyright>Copyright © 2026 U.S. Army Corps of Engineers</Copyright>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
  </PropertyGroup>

  <ItemGroup>
    <!-- Link shared MSTest parallelization settings from the Verification project.
         Applies [assembly: Parallelize(...)] to this assembly too. -->
    <Compile Include="..\RMC.TotalRisk.Verification\MSTestSettings.cs" Link="MSTestSettings.cs" />
    <!-- Computational seed-map scenarios execute in Verification. -->
    <Compile Remove="Core\SamplerSeedMapTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RMC.TotalRisk\RMC.TotalRisk.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyTitle>RMC.TotalRisk.Api</AssemblyTitle>
    <Description>REST API and MCP server for the RMC-TotalRisk quantitative risk analysis engine.</Description>
    <Company>U.S. Army Corps of Engineers</Company>
    <Product>RMC-TotalRisk</Product>
    <Copyright>Copyright © 2026 U.S. Army Corps of Engineers</Copyright>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Direct reference lifts the transitive Microsoft.OpenApi above the vulnerable 2.0.0 (NU1903). -->
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RMC.TotalRisk\RMC.TotalRisk.csproj" />
  </ItemGroup>

</Project>

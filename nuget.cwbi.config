<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for the container image and the CWBI workflow. The root NuGet.config also lists
  a developer-machine feed that does not exist on build agents, so the Dockerfile, the CWBI
  workflow, and scripts/Prepare-CwbiRelease.ps1 restore with this file instead.
-->
<configuration>
  <packageSources>
    <clear />
    <!-- In-repo prerelease RMC.Numerics feed until 2.2.0 ships; see scripts/pack-local-numerics.ps1. -->
    <add key="local-feed" value="local-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
